{
  "providers": {
    "type": "template_list",
    "description": "Providers",
    "templates": {
      "openai": {
        "name": "OpenAI",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "Name",
            "required": true
          },
          "protocol": {
            "type": "string",
            "description": "Protocol",
            "options": [
              "openai",
              "openai-compatible",
              "anthropic-messages",
              "openai-responses",
              "gemini-generate-content",
              "ollama-chat"
            ],
            "default": "openai"
          },
          "base_url": {
            "type": "string",
            "description": "Base URL",
            "default": "https://api.openai.com/v1"
          },
          "api_key": {
            "type": "string",
            "description": "API key",
            "secret": true
          }
        }
      },
      "anthropic": {
        "name": "Anthropic",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "Name",
            "required": true
          },
          "protocol": {
            "type": "string",
            "description": "Protocol",
            "options": [
              "openai",
              "openai-compatible",
              "anthropic-messages",
              "openai-responses",
              "gemini-generate-content",
              "ollama-chat"
            ],
            "default": "anthropic-messages"
          },
          "base_url": {
            "type": "string",
            "description": "Base URL",
            "default": "https://api.anthropic.com"
          },
          "api_key": {
            "type": "string",
            "description": "API key",
            "secret": true
          }
        }
      },
      "gemini": {
        "name": "Gemini",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "Name",
            "required": true
          },
          "protocol": {
            "type": "string",
            "description": "Protocol",
            "options": [
              "openai",
              "openai-compatible",
              "anthropic-messages",
              "openai-responses",
              "gemini-generate-content",
              "ollama-chat"
            ],
            "default": "gemini-generate-content"
          },
          "base_url": {
            "type": "string",
            "description": "Base URL",
            "default": "https://generativelanguage.googleapis.com/v1beta"
          },
          "api_key": {
            "type": "string",
            "description": "API key",
            "secret": true
          }
        }
      },
      "deepseek": {
        "name": "DeepSeek",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "Name",
            "required": true
          },
          "protocol": {
            "type": "string",
            "description": "Protocol",
            "options": [
              "openai",
              "openai-compatible",
              "anthropic-messages",
              "openai-responses",
              "gemini-generate-content",
              "ollama-chat"
            ],
            "default": "openai-compatible"
          },
          "base_url": {
            "type": "string",
            "description": "Base URL",
            "default": "https://api.deepseek.com/v1"
          },
          "api_key": {
            "type": "string",
            "description": "API key",
            "secret": true
          }
        }
      },
      "ollama": {
        "name": "Ollama",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "Name",
            "required": true
          },
          "protocol": {
            "type": "string",
            "description": "Protocol",
            "options": [
              "openai",
              "openai-compatible",
              "anthropic-messages",
              "openai-responses",
              "gemini-generate-content",
              "ollama-chat"
            ],
            "default": "ollama-chat"
          },
          "base_url": {
            "type": "string",
            "description": "Base URL",
            "default": "http://localhost:11434"
          },
          "api_key": {
            "type": "string",
            "description": "API key",
            "secret": true
          }
        }
      },
      "custom": {
        "name": "Custom",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "Name",
            "required": true
          },
          "protocol": {
            "type": "string",
            "description": "Protocol",
            "options": [
              "openai",
              "openai-compatible",
              "anthropic-messages",
              "openai-responses",
              "gemini-generate-content",
              "ollama-chat"
            ],
            "default": "openai-compatible"
          },
          "base_url": {
            "type": "string",
            "description": "Base URL",
            "required": true
          },
          "api_key": {
            "type": "string",
            "description": "API key",
            "secret": true
          }
        }
      }
    }
  },
  "default_persona": {
    "type": "string",
    "description": "Default persona",
    "profile": true,
    "options_from": {
      "source": "@agent/personas"
    }
  },
  "history_entries": {
    "type": "int",
    "description": "History entries",
    "default": 20,
    "slider": {
      "min": 0,
      "max": 500,
      "step": 1
    }
  },
  "mcp_servers": {
    "type": "list",
    "description": "MCP servers",
    "items": {
      "name": {
        "type": "string",
        "description": "Name",
        "required": true
      },
      "transport": {
        "type": "string",
        "description": "Transport",
        "options": [
          "stdio",
          "streamable-http"
        ],
        "default": "stdio"
      },
      "command": {
        "type": "string",
        "description": "Command",
        "condition": {
          "transport": "stdio"
        }
      },
      "args": {
        "type": "list",
        "description": "Arguments",
        "condition": {
          "transport": "stdio"
        }
      },
      "env": {
        "type": "list",
        "description": "Environment variables",
        "items": {
          "name": {
            "type": "string",
            "description": "Name",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Secret value",
            "secret": true
          }
        },
        "condition": {
          "transport": "stdio"
        }
      },
      "url": {
        "type": "string",
        "description": "URL",
        "condition": {
          "transport": "streamable-http"
        }
      },
      "headers": {
        "type": "list",
        "description": "HTTP headers",
        "items": {
          "name": {
            "type": "string",
            "description": "Name",
            "required": true
          },
          "value": {
            "type": "string",
            "description": "Secret value",
            "secret": true
          }
        },
        "condition": {
          "transport": "streamable-http"
        }
      }
    }
  },
  "skills_dir": {
    "type": "string",
    "description": "Skills directory",
    "hint": "Empty disables skills. Relative paths use the plugin working directory. Use Reload skills after editing files.",
    "default": ""
  },
  "llm_service_allowed_plugins": {
    "type": "list",
    "description": "Plugins allowed to generate text",
    "default": [
      "*"
    ]
  },
  "chat_model": {
    "type": "string",
    "description": "Chat model",
    "options_from": {
      "source": "@agent/llm.models",
      "filter": {
        "type": "chat"
      }
    },
    "profile": true
  },
  "models": {
    "type": "list",
    "description": "Models",
    "items": {
      "name": {
        "type": "string",
        "description": "Name",
        "required": true
      },
      "provider": {
        "type": "string",
        "description": "Provider",
        "required": true
      },
      "model": {
        "type": "string",
        "description": "Model ID",
        "required": true
      },
      "type": {
        "type": "string",
        "description": "Model type",
        "options": [
          "chat",
          "speech_to_text",
          "text_to_speech",
          "embedding",
          "rerank",
          "decision"
        ],
        "default": "chat"
      },
      "max_tokens": {
        "type": "int",
        "description": "Maximum output tokens",
        "hint": "Must be at least 1.",
        "default": 2048,
        "condition": {
          "type": "chat"
        }
      },
      "image_input": {
        "type": "bool",
        "description": "Image input",
        "default": false,
        "condition": {
          "type": "chat"
        }
      }
    }
  },
  "max_attempts": {
    "type": "int",
    "description": "Maximum attempts per chat model",
    "hint": "Includes the first request. Must be at least 1.",
    "default": 3
  },
  "fallback_chat_models": {
    "type": "list",
    "description": "Fallback chat models",
    "default": [],
    "options_from": {
      "source": "@agent/llm.models",
      "filter": {
        "type": "chat"
      }
    }
  },
  "image_caption_model": {
    "type": "string",
    "description": "Image caption model",
    "hint": "Choose a chat model that accepts images, or leave empty to keep image placeholders.",
    "options_from": {
      "source": "@agent/llm.models",
      "filter": {
        "type": "chat"
      }
    },
    "profile": true
  },
  "image_caption_prompt": {
    "type": "text",
    "description": "Image caption prompt"
  },
  "triggers": {
    "type": "list",
    "description": "Free conversation triggers",
    "options": [
      "mention",
      "wake_word",
      "private"
    ],
    "labels": [
      "Group mention or reply",
      "Wake word",
      "Private chat"
    ],
    "default": [],
    "profile": true
  },
  "wake_words": {
    "type": "list",
    "description": "Wake words",
    "default": [],
    "profile": true
  },
  "member_sessions": {
    "type": "bool",
    "description": "Separate group conversations by member",
    "default": false,
    "profile": true
  }
}
